# Provider: bedrock | azure_openai
SRE_PROVIDER=bedrock

# --- AWS Bedrock ---
SRE_AWS_REGION=us-east-1
SRE_BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# --- Azure OpenAI (leave API key empty to use Entra ID / managed identity) ---
SRE_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
SRE_AZURE_OPENAI_DEPLOYMENT=gpt-4o
SRE_AZURE_OPENAI_API_KEY=

# --- Cluster access: incluster | eks | aks | kubeconfig ---
SRE_CLUSTER_TYPE=kubeconfig
SRE_KUBECONFIG=
# remote clusters only:
SRE_CLUSTER_NAME=
SRE_CLUSTER_ENDPOINT=
SRE_CLUSTER_CA_DATA=

# Optional guard rails
SRE_ALLOWED_NAMESPACES=
SRE_MAX_STEPS=8
